# Configuracion local de AWS. Copiar a .env y completar solo en tu equipo.
# Credenciales de acceso programatico (no usuario/contrasena de la consola).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Obligatorio si las credenciales son temporales; dejar vacio en otro caso.
AWS_SESSION_TOKEN=

# Alternativa: dejar las tres claves anteriores vacias y usar un perfil AWS/SSO.
AWS_PROFILE=
AWS_REGION=

# Nombres reales de los buckets desplegados por audit-pipeline/terraform.
PPS_POLICIES_BUCKET=
PPS_REPORTS_BUCKET=
