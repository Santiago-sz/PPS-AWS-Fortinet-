<mxfile host="app.diagrams.net" agent="PPS docs generator" version="24.7.17" type="device"><diagram id="04-conectividad-fortigate.drawio" name="04 Conectividad con el FortiGate"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Tres opciones para que audit_executor alcance la REST API del FortiGate (HTTPS/443, solo GET)" style="text;html=1;fontStyle=1;fontSize=16;align=left;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="(a) FortiGate on-prem + VPN Site-to-Site + executor en VPC — escenario institucional" style="swimlane;startSize=30;rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#F1F8E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="500" height="620" as="geometry"/></mxCell><mxCell id="c4" value="VPC us-east-1 (p. ej. vpc-0542264dd516d931e 10.42.0.0/16)" style="swimlane;startSize=30;rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#FF9900;" vertex="1" parent="c3"><mxGeometry x="15" y="40" width="470" height="300" as="geometry"/></mxCell><mxCell id="c5" value="Lambda audit_executor&lt;br&gt;en subred privada&lt;br&gt;executor_subnet_ids + executor_security_group_ids&lt;br&gt;(+ AWSLambdaVPCAccessExecutionRole)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="c4"><mxGeometry x="15" y="45" width="210" height="90" as="geometry"/></mxCell><mxCell id="c6" value="VPC endpoints: S3 (Gateway), Secrets Manager, SNS (Interface)&lt;br&gt;o NAT Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#D5E8D4;strokeColor=#2E7D32;" vertex="1" parent="c4"><mxGeometry x="245" y="45" width="210" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Virtual Private Gateway / Transit Gateway&lt;br&gt;(túnel IPsec)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E1D5E7;strokeColor=#6A1B9A;" vertex="1" parent="c4"><mxGeometry x="15" y="170" width="210" height="60" as="geometry"/></mxCell><mxCell id="c8" value="SG executor: egress 443 → red on-prem&lt;br&gt;+ 443 → endpoints AWS" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacingLeft=6;" vertex="1" parent="c4"><mxGeometry x="245" y="170" width="210" height="60" as="geometry"/></mxCell><mxCell id="c9" value="Red institucional (on-prem)" style="swimlane;startSize=30;rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#F3F3F3;strokeColor=#424242;" vertex="1" parent="c3"><mxGeometry x="15" y="360" width="470" height="130" as="geometry"/></mxCell><mxCell id="c10" value="Customer Gateway = el propio FortiGate&lt;br&gt;(IPsec phase1/phase2, IP pública estática)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E0E0E0;strokeColor=#424242;" vertex="1" parent="c9"><mxGeometry x="15" y="40" width="220" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Interfaz de gestión privada&lt;br&gt;REST API 443 · trusted host = subred del executor" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E0E0E0;strokeColor=#424242;" vertex="1" parent="c9"><mxGeometry x="250" y="40" width="205" height="70" as="geometry"/></mxCell><mxCell id="c12" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="c4" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="c4" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="IPsec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="c3" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="c9" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="+ Escenario real de la institución · sin exposición pública · cifrado extremo a extremo&lt;br&gt;− Requiere equipo real e IP pública fija on-prem · coordinación con redes · costo horario VGW/TGW&lt;br&gt;Cuándo: despliegue en la institución (PPS II / producción)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c3"><mxGeometry x="15" y="505" width="470" height="100" as="geometry"/></mxCell><mxCell id="c17" value="(b) FortiGate-VM en AWS, misma VPC/región — recomendada para la tesis" style="swimlane;startSize=30;rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="560" y="50" width="500" height="620" as="geometry"/></mxCell><mxCell id="c18" value="VPC us-east-1 10.42.0.0/16 (o nueva VPC con peering)" style="swimlane;startSize=30;rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#FF9900;" vertex="1" parent="c17"><mxGeometry x="15" y="40" width="470" height="400" as="geometry"/></mxCell><mxCell id="c19" value="Lambda audit_executor&lt;br&gt;subred privada A&lt;br&gt;SG-exec: egress 443 → SG-fgt" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="c18"><mxGeometry x="15" y="45" width="210" height="80" as="geometry"/></mxCell><mxCell id="c20" value="VPC endpoints S3 / Secrets Manager / SNS&lt;br&gt;(o NAT Gateway)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#D5E8D4;strokeColor=#2E7D32;" vertex="1" parent="c18"><mxGeometry x="245" y="45" width="210" height="80" as="geometry"/></mxCell><mxCell id="c21" value="EC2 FortiGate-VM64 on-demand (c5.large)&lt;br&gt;base: fortigate-sandbox-2026-06-07/ (cambiar provider.tf a us-east-1)&lt;br&gt;SG-fgt: ingress 443 SOLO desde SG-exec (no 0.0.0.0/0)&lt;br&gt;usuario API solo lectura · trusted host = subred A" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E0E0E0;strokeColor=#424242;" vertex="1" parent="c18"><mxGeometry x="15" y="160" width="440" height="100" as="geometry"/></mxCell><mxCell id="c22" value="Opcional: ENI pública para la consola de administración del laboratorio, restringida a la IP del operador" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c18"><mxGeometry x="15" y="290" width="440" height="50" as="geometry"/></mxCell><mxCell id="c23" value="GET /api/v2/cmdb/* (privado)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="c18" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="c18" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="+ Todo en AWS e IaC reproducible · sin equipo físico · evaluación controlada&lt;br&gt;− Costo por hora de la VM + licencia on-demand · el sandbox existente está en sa-east-1 (otra región/VPC)&lt;br&gt;Cuándo: demostración y evaluación de la tesis" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c17"><mxGeometry x="15" y="455" width="470" height="150" as="geometry"/></mxCell><mxCell id="c26" value="(c) IP pública de gestión + trusted hosts — NO recomendada" style="swimlane;startSize=30;rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#FFEBEE;strokeColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="1100" y="50" width="500" height="620" as="geometry"/></mxCell><mxCell id="c27" value="Lambda audit_executor fuera de VPC&lt;br&gt;(executor_subnet_ids = [])&lt;br&gt;SIN IP de egreso fija" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="c26"><mxGeometry x="20" y="50" width="210" height="80" as="geometry"/></mxCell><mxCell id="c28" value="Alternativa: executor en VPC + NAT Gateway con EIP fija&lt;br&gt;(única forma de que el trusted host tenga sentido)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c26"><mxGeometry x="260" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="c29" value="Internet" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;shape=ellipse;" vertex="1" parent="c26"><mxGeometry x="150" y="180" width="200" height="50" as="geometry"/></mxCell><mxCell id="c30" value="FortiGate con 443 de gestión expuesto a Internet&lt;br&gt;trusted hosts = EIP del NAT&lt;br&gt;HTTPS con certificado válido" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E0E0E0;strokeColor=#424242;" vertex="1" parent="c26"><mxGeometry x="20" y="290" width="460" height="80" as="geometry"/></mxCell><mxCell id="c31" value="egress dinámico" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="c26" source="c27" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="EIP fija" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="c26" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="c26" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="+ Mínimo esfuerzo de red&lt;br&gt;− Superficie de gestión expuesta a Internet · sin IP fija los trusted hosts no protegen · aun con NAT el puerto queda visible · el sandbox actual expone 443 a 0.0.0.0/0&lt;br&gt;Cuándo: solo pruebas puntuales y temporales" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c26"><mxGeometry x="20" y="400" width="460" height="150" as="geometry"/></mxCell><mxCell id="c35" value="Común a las tres: perfil de acceso FortiOS de solo lectura (config system accprofile … read) · usuario config system api-user con set accprofile + trusthost · token vía execute api-user generate-key · token en Secrets Manager (pps-prod-fortigate-token) · FORTIGATE_HOST por Terraform · TLS verificado por defecto (FORTIGATE_VERIFY_SSL)." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1580" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>