<mxfile host="app.diagrams.net" agent="PPS docs generator" version="24.7.17" type="device"><diagram id="03-harness-capas-de-control.drawio" name="03 Harness — capas de control"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Harness Engineering: el modelo en el centro, rodeado de controles deterministas (Agente = Modelo + Arnés)" style="text;html=1;fontStyle=1;fontSize=16;align=left;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Arnés de desarrollo y evaluación — tests 275 (lambda) / 30 (api) / 45 (desktop) · corpus adversarial del validador · ruff · checkov · terraform validate · CI (.github/workflows/ci.yml) · AGENTS.md · evals/ (check_recall, endpoint_precision, remediation_coverage, first_attempt_pass_rate)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFF8E1;strokeColor=#B38600;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1180" height="760" as="geometry"/></mxCell><mxCell id="c4" value="Observabilidad — observability.py: eventos JSON (llm_call, generation_result, generator_result, awaiting_approval, executor_result) + métricas EMF PPS/AuditPipeline · Bedrock Model Invocation Logging · DLQ + alarmas (monitoring.tf)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFDE7;strokeColor=#B38600;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="78" y="88" width="1104" height="684" as="geometry"/></mxCell><mxCell id="c5" value="Compuerta humana — AUTO_EXECUTE=false → awaiting_approval · pps-api aws list-pending / approve &amp;lt;run_id&amp;gt; · remediaciones {summary, steps, fortigate_cli} solo como propuesta" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F3E5F5;strokeColor=#6A1B9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="116" y="126" width="1028" height="608" as="geometry"/></mxCell><mxCell id="c6" value="Verificación independiente — handler_executor.py: SHA-256 del script == manifest == payload antes del AST · script_validator.validate otra vez, desde cero · rol sin bedrock:* (no puede regenerar)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#EDE7F6;strokeColor=#6A1B9A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="154" y="164" width="952" height="532" as="geometry"/></mxCell><mxCell id="c7" value="Presupuestos — sandbox.py: max_wall_clock_s=120 (gate por llamada + SIGALRM) · max_fgt_calls=40 · max_findings=500 · __builtins__={} + 21 nombres seguros · corte → truncated con hallazgos parciales" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFEBEE;strokeColor=#B71C1C;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="192" y="202" width="876" height="456" as="geometry"/></mxCell><mxCell id="c8" value="Herramientas acotadas — toolkit.py: fgt.get(label) memoizado / fgt.endpoints() · report.finding(check_id, status, evidence) / report.note · clause_ref y remediation resueltos server-side · fortigate_client GET-only sobre 31 endpoints" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="240" width="800" height="380" as="geometry"/></mxCell><mxCell id="c9" value="Restricciones estáticas — script_validator.py: allowlist de nodos AST · Import/ClassDef/Lambda/While/Try/Raise/With/… denegados · getattr/eval/exec/type/open denegados · sin '__' · MAX_AST_NODES=4000 · MAX_NESTING=3 · literal del catálogo · cobertura de check_id" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E3F2FD;strokeColor=#1565C0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="268" y="278" width="724" height="304" as="geometry"/></mxCell><mxCell id="c10" value="Prompt + esquema — MAP_SYSTEM_PROMPT (JSON PolicyCheck, 'no inventar controles', remediación reversible) · REDUCE_SYSTEM_PROMPT (reglas absolutas del sandbox) · MAX_MAP_CALLS=12, nunca truncar" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F1F8E9;strokeColor=#558B2F;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="306" y="316" width="648" height="228" as="geometry"/></mxCell><mxCell id="c11" value="MODELO&lt;br&gt;Claude Sonnet 4.6 vía Amazon Bedrock&lt;br&gt;(Converse, IAM, cachePoint)&lt;br&gt;&lt;br&gt;Entrada: chunks + catálogo · Salida: PolicyCheck[] y script.py" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFE0B2;strokeColor=#E65100;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="344" y="354" width="572" height="152" as="geometry"/></mxCell><mxCell id="c12" value="rechazo → feedback estructurado {attempt, failure_kind, rule_id, line, col, snippet}&lt;br&gt;hasta 3 intentos (llm_client.generate_script_with_retries)" style="html=1;curved=1;endArrow=block;endFill=1;strokeColor=#E65100;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="288" y="398" as="sourcePoint"/><mxPoint x="364" y="496" as="targetPoint"/><Array as="points"><mxPoint x="288" y="566"/></Array></mxGeometry></mxCell><mxCell id="c13" value="script candidato → validate()" style="html=1;curved=1;endArrow=block;endFill=1;strokeColor=#1565C0;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="896" y="506" as="sourcePoint"/><mxPoint x="972" y="398" as="targetPoint"/><Array as="points"><mxPoint x="956" y="566"/></Array></mxGeometry></mxCell><mxCell id="c14" value="evals → ajuste de prompt / catálogo (brecha password-policy/ntp/log.* detectada y resuelta: 11 → 31 endpoints)" style="html=1;curved=1;endArrow=block;endFill=1;dashed=1;strokeColor=#B38600;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="800" as="sourcePoint"/><mxPoint x="366" y="336" as="targetPoint"/><Array as="points"><mxPoint x="100" y="450"/></Array></mxGeometry></mxCell><mxCell id="c15" value="fallo de integridad / re-validación / presupuesto&lt;br&gt;→ could_not_audit | truncated → S3 + SNS + eventos" style="html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#B71C1C;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1106" y="430" as="sourcePoint"/><mxPoint x="1190" y="74" as="targetPoint"/><Array as="points"><mxPoint x="1260" y="430"/><mxPoint x="1260" y="74"/></Array></mxGeometry></mxCell><mxCell id="c16" value="Lectura: cada capa es determinista y falla cerrado; ninguna confía en la anterior (el executor repite integridad y validación). El modelo solo puede expresar lo que las capas interiores permiten, y las exteriores miden cuánto se equivoca." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1180" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>