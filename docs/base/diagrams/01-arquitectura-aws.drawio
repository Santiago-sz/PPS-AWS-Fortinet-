iteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#D5E8D4;strokeColor=#2E7D32;" vertex="1" parent="c12"><mxGeometry x="330" y="270" width="290" height="100" as="geometry"/></mxCell><mxCell id="c19" value="Compuerta humana (AUTO_EXECUTE=false)&lt;br&gt;status = awaiting_approval → el operador revisa&lt;br&gt;manifest/script y ejecuta pps-api aws approve &amp;lt;run_id&amp;gt;&lt;br&gt;(InvokeFunction Event con el mismo puntero firmado)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacingLeft=6;" vertex="1" parent="c12"><mxGeometry x="690" y="265" width="310" height="100" as="geometry"/></mxCell><mxCell id="c20" value="Lambda pps-prod-audit-executor&lt;br&gt;handler_executor.lambda_handler&lt;br&gt;300 s · 512 MB · stdlib-only · sin bedrock:*&lt;br&gt;SHA-256 + re-validación AST → sandbox (120 s / 40 calls / 500 findings)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="c12"><mxGeometry x="330" y="450" width="290" height="110" as="geometry"/></mxCell><mxCell id="c21" value="Secrets Manager&lt;br&gt;pps-prod-fortigate-token&lt;br&gt;{&quot;token&quot;: &quot;...&quot;} (placeholder + ignore_changes)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E1D5E7;strokeColor=#6A1B9A;" vertex="1" parent="c12"><mxGeometry x="30" y="460" width="230" height="80" as="geometry"/></mxCell><mxCell id="c22" value="SNS pps-prod-notifications&lt;br&gt;email (confirmar suscripción)&lt;br&gt;reportes del executor + alarmas" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F8CECC;strokeColor=#B71C1C;" vertex="1" parent="c12"><mxGeometry x="690" y="455" width="310" height="80" as="geometry"/></mxCell><mxCell id="c23" value="CloudWatch Logs + métricas EMF (PPS/AuditPipeline)&lt;br&gt;/aws/lambda/pps-prod-{policy-generator,audit-executor,assessor}&lt;br&gt;eventos llm_call · generation_result · generator_result · executor_result&lt;br&gt;Alarmas *-errors y *-dlq-messages" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFF2CC;strokeColor=#B38600;" vertex="1" parent="c12"><mxGeometry x="690" y="570" width="310" height="100" as="geometry"/></mxCell><mxCell id="c24" value="SQS DLQ&lt;br&gt;pps-prod-policy-generator-dlq&lt;br&gt;pps-prod-audit-executor-dlq (14 d)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F8CECC;strokeColor=#B71C1C;" vertex="1" parent="c12"><mxGeometry x="30" y="600" width="230" height="70" as="geometry"/></mxCell><mxCell id="c25" value="IAM (mínimo privilegio, roles disjuntos): pps-prod-generator-role → Bedrock InvokeModel, S3 policies (get/list), S3 reports artifacts/* + reports/* (put), lambda:InvokeFunction executor, DLQ, logs · pps-prod-executor-role → secret FortiGate (get), S3 artifacts/* (get), reports/* (put), sns:Publish, DLQ, logs, [AWSLambdaVPCAccessExecutionRole si VPC] · pps-prod-lambda-role → assessor NIST legacy (schedule apagado)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E1D5E7;strokeColor=#6A1B9A;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="c12"><mxGeometry x="30" y="700" width="970" height="90" as="geometry"/></mxCell><mxCell id="c26" value="Red del cliente / laboratorio" style="swimlane;startSize=30;rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#F3F3F3;strokeColor=#424242;" vertex="1" parent="1"><mxGeometry x="1450" y="420" width="230" height="200" as="geometry"/></mxCell><mxCell id="c27" value="FortiGate (FortiOS)&lt;br&gt;REST API https://&amp;lt;host&amp;gt;/api/v2/cmdb/*&lt;br&gt;usuario API de solo lectura + trusted hosts&lt;br&gt;(hoy: no existe en la cuenta)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#E0E0E0;strokeColor=#424242;" vertex="1" parent="c26