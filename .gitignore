# Google Drive sync noise (this whole tree lives under Google Drive Desktop)
desktop.ini

# Editor
.cursor/

# Local FortiGate sandbox repository (kept outside parent Git tracking)
/P-Terraform-Forti-AWS/

# Terraform (each subfolder also has its own, more specific .gitignore)
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.backup
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example

# Lambda packaging / layer build output (regenerable)
audit-engine/lambda.zip
audit-engine/layers/

# Eval results (regenerable; keep the folder marker)
audit-engine/evals/results/*
!audit-engine/evals/results/.gitkeep

# Desktop application / local development
.venv/
.venv-gui/
.venv-harness/
.harness/
.pps-api/
*.egg-info/
.env
.env.*
!.env.example
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
gui/build/
gui/dist/
gui/*.egg-info/

# Terraform plan output (never commit a plan: it can embed variable values)
tfplan
*.tfplan

# draw.io autosave temp files
.$*.dtmp
